# ビルド成果物とディスクイメージ
out/

# Python のバイトコードキャッシュ。
# 故障注入から復旧してもテストが落ち続け、原因が古い .pyc だったことがある。
__pycache__/

# 上流辞書(SKK-JISYO.L)。GPL で再配布可だが 4.5MB あり再取得できるので置かない。
tsukushi/dic/upstream/

# macOS
.DS_Store

# ビルド成果物。ずれるのでツリーには置かず、Release で配る。
*.COM

# 原物（FD / JED）は絶対に置かない。二次的な網。
# 主たる防御は置き場を分けたことで、原物は PC98/_local/originals/ にある
# （公開 repo の配下に存在しない）。一度コミットすると git rm しても
# 履歴からは公開されたままなので、ignore を当てにしない。
#
# ワイルドカードにしないこと。*.MCR のように広く書くと、将来この repo が
# 持つ自作物のファイルを無言で飲み込む。原物の実ファイル名だけを列挙する。
FD.DOC
FD98_313.DOC
FDCUST2.DOC
FD.CFG
JED.EXE
JED.DOC
JEDMAC.DOC
JED.CFG

# テストの生成物。gen_*.py が TSUBAKI.C から抽出して作るので、正典は生成スクリプト側。
# 追跡すると、TSUBAKI.C を直したあと再生成を忘れたときに
# 「古いテストが通って安心する」事故が起きる。
tsubaki/tools/search_core_test.c
tsubaki/tools/undo_core_test.c
